PORT=8000
# Comma-separated list of allowed frontend origins
# Local dev: just localhost. Production: add your deployed frontend URL.
# e.g. CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
CORS_ORIGIN=*

# Neon PostgreSQL (connection string)
DATABASE_URL=postgresql://neondb_owner:npg_5NPyBLVnm2dE@ep-soft-surf-aqgbcphe-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d


# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Email OTP (nodemailer SMTP) ───────────────────────────────────────────────
# Leave blank to use console-log fallback in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
